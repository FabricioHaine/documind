# DocuMind — modelo de ambiente. Copie para backend/.env e preencha.
# NUNCA versionar o arquivo real (.gitignore cobre *.env).

# --- Banco de dados (PostgreSQL 18 + pgvector; criado por scripts/setup-database.ps1) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/documind
SPRING_DATASOURCE_USERNAME=documind
SPRING_DATASOURCE_PASSWORD=trocar-por-senha

# --- Integracao de IA (OpenAI-compatible: Ollama local, vLLM, etc.) ---
# Sem essas variaveis a API sobe, mas os endpoints de RAG respondem 503 IA_NAO_CONFIGURADA.
DOCUMIND_AI_BASE_URL=http://localhost:11434/v1
DOCUMIND_AI_API_KEY=
DOCUMIND_AI_REQUEST_TIMEOUT_SECONDS=300
DOCUMIND_AI_CHAT_MODEL=llama3.2:3b
DOCUMIND_AI_EMBEDDING_MODEL=nomic-embed-text
DOCUMIND_AI_EMBEDDING_DIMENSIONS=768

# --- Seguranca ---
# Minimo de 32 caracteres. Gere forte, ex. PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
DOCUMIND_JWT_SECRET=trocar-por-segredo-de-32-chars-minimo
